<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, Android 8 and later. A legacy square icon is shrunk onto a
     launcher-chosen backdrop on these versions, which for a dark icon means a
     white disc with a small dark square in it; an adaptive icon lets the sky
     fill the mask instead. The three layers are generated by tool/make_icon.py
     and the monochrome one feeds Android 13's themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
